# --- Server (server/index.mjs) ---

# Port the contact API and admin API listen on
PORT=4000

# --- Admin authentication (required to use /admin) ---
# If ADMIN_PASSWORD is not set, the admin login is disabled (secure default).
# Never use a weak password in production.
ADMIN_USER=admin
# ADMIN_PASSWORD=change-this-to-a-long-random-password

# Session lifetime in hours (default 12)
# SESSION_TTL_HOURS=12

# Set to "true" when serving over HTTPS so the admin session cookie
# is marked Secure.
# COOKIE_SECURE=true

# Allowed CORS origins (comma separated) for the frontend
# CORS_ORIGIN=http://localhost:5173,https://your-domain.com

# The email address that receives contact form submissions
CONTACT_RECIPIENT=hello@abdullahtariq.dev

# ---- Email delivery - choose ONE provider ----

# Option 1: SMTP (Nodemailer). Set SMTP_HOST to enable it.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-account@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Portfolio Contact <you@example.com>

# Option 2: Resend API.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=Portfolio <onboarding@resend.dev>

# If neither SMTP_HOST nor RESEND_API_KEY is set, submissions are logged
# to the server console (development fallback only, NOT for production).

# --- Frontend (Vite) ---

# Optional: override the contact endpoint the form posts to.
# Defaults to "/api/contact" (proxied to the server in dev).
# VITE_CONTACT_ENDPOINT=/api/contact

# IMPORTANT: variables prefixed with VITE_ are bundled into the frontend.
# Never put secrets in VITE_ variables — only the server-side variables above
# may hold API keys and credentials.